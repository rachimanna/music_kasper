# Обязательно: токен от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Jamendo — бесплатные легальные полные треки (Creative Commons).
# Получить client_id: https://devportal.jamendo.com → зарегистрироваться → создать приложение.
JAMENDO_CLIENT_ID=

# Если полной версии нет — присылать 30-секундное превью Deezer с пометкой (true/false)
PREVIEW_ENABLED=true

# Необязательно: свой сервер с полными файлами, на которые у вас есть права.
# Поля: {id} (ID трека Deezer), {artist}, {title}. Значения кодируются автоматически.
AUDIO_SOURCE_URL_TEMPLATE=

# Необязательные настройки (показаны значения по умолчанию)
# DB_PATH=music_bot.db
# RATE_LIMIT=1.0
# PAGE_SIZE=5
# SEARCH_LIMIT=25
# INLINE_LIMIT=15
# SEARCH_CACHE_TTL=21600
# DOWNLOAD_DIR=            # пусто = системная временная папка ($TMPDIR в Termux)
# MAX_SOURCE_SIZE_MB=100
# MAX_UPLOAD_SIZE_MB=49
# AUDIO_BITRATE_KBPS=192
# MAX_CONCURRENT_DOWNLOADS=3
# WEB_SERVER_ENABLED=true  # для Termux можно выключить: false
# PORT=8080                # Render выставляет сам
